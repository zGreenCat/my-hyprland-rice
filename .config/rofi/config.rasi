@theme "/dev/null"
@import "colors.rasi"

configuration {
	modi: "drun";
	display-drun: "";
	drun-display-format: "{icon} {name}";
	font: "JetBrainsMono Nerd Font 11";
	show-icons: true;
	icon-theme: "Colloid";
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       540px;
    border:                      2px solid;
    border-color:                @secondary-container;
    border-radius:               @rofi-radius;
    background-color:            @on-primary-fixed;
}

mainbox {
    spacing:                     0px;
    padding:                     12px;
    background-color:            transparent;
    orientation:                 vertical;
    children:                    [ "inputbar", "listview" ];
}

inputbar {
    spacing:                     10px;
    padding:                     12px 16px;
    margin:                      0px 0px 10px 0px;
    border-radius:               @rofi-radius;
    background-color:            @on-primary;
    text-color:                  @on-surface;
    children:                    [ "textbox-prompt-colon", "entry" ];
}

textbox-prompt-colon {
    expand:                      false;
    str:                         " ";
    background-color:            inherit;
    text-color:                  @primary-fixed;
}

entry {
    background-color:            inherit;
    text-color:                  inherit;
    cursor:                      text;
    placeholder:                 "Buscar apps...";
    placeholder-color:           @secondary-container;
}

listview {
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    fixed-height:                false;
    spacing:                     4px;
    background-color:            transparent;
    text-color:                  @on-surface;
}

element {
    spacing:                     12px;
    padding:                     8px 12px;
    border-radius:               @rofi-radius;
    background-color:            transparent;
    text-color:                  @on-surface;
    cursor:                      pointer;
}

element normal.normal  { background-color: transparent;  text-color: @on-surface; }
element normal.urgent  { background-color: @error;       text-color: @on-surface; }
element normal.active  { background-color: @on-primary;  text-color: @on-surface; }
element selected.normal { background-color: @primary-container; text-color: @on-primary-container; }
element selected.urgent { background-color: @error;     text-color: @on-primary-fixed; }
element selected.active { background-color: @error;     text-color: @on-primary-fixed; }

element-icon {
    background-color:            transparent;
    size:                        28px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

error-message {
    padding:                     15px;
    border-radius:               @rofi-radius;
    background-color:            @on-primary;
    text-color:                  @on-surface;
}
