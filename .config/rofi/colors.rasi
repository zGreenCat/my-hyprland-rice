/* Theme: Crimson Noir */
* {
    primary:              #e8002a;
    secondary:            #a04060;
    background:           #030001;
    foreground:           #e8d0d4;
    surface:              #080204;

    primary-container:    #1a0508;
    on-primary-container: #e8d0d4;
    on-primary:           #1a0508;
    on-primary-fixed:     #030001;
    on-surface:           #e8d0d4;
    secondary-container:  #6b2030;
    on-secondary:         #c0a0a8;
    error:                #ff1040;

    rofi-radius:          0px;
}
