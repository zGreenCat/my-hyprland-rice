/* Generated by Matugen - Space Theme Colors */
* {
    primary:              #{{ colors.primary.default.hex_stripped }};
    secondary:            #{{ colors.secondary.default.hex_stripped }};
    background:           #{{ colors.background.default.hex_stripped }};
    foreground:           #{{ colors.on_background.default.hex_stripped }};
    surface:              #{{ colors.surface.default.hex_stripped }};

    primary-container:    #{{ colors.primary_container.default.hex_stripped }};
    on-primary-container: #{{ colors.on_primary_container.default.hex_stripped }};
    on-primary:           #{{ colors.surface_container.default.hex_stripped }};
    on-primary-fixed:     #{{ colors.surface_container_lowest.default.hex_stripped }};
    on-surface:           #{{ colors.on_surface.default.hex_stripped }};
    secondary-container:  #{{ colors.primary.default.hex_stripped }};
    on-secondary:         #{{ colors.on_primary_container.default.hex_stripped }};
    primary-fixed:        #{{ colors.primary.default.hex_stripped }};
    error:                #{{ colors.error.default.hex_stripped }};
}
